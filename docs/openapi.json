{
  "openapi": "3.1.0",
  "info": {
    "title": "bellycoin Node RPC",
    "version": "0.1.0"
  },
  "paths": {
    "/status": { "get": { "summary": "Get node and chain status", "responses": { "200": { "description": "Node status with finalized_height and total_mined, total_burned, and total_supply in pearl" } } } },
    "/fee-policy": { "get": { "summary": "Get relay fee and block emission policy", "responses": { "200": { "description": "Fee policy" } } } },
    "/transaction": { "post": { "summary": "Submit a canonical Borsh transaction", "requestBody": { "required": true, "content": { "application/octet-stream": { "schema": { "type": "string", "contentEncoding": "binary" } } } }, "responses": { "200": { "description": "Accepted transaction ID" }, "400": { "description": "Invalid transaction" } } } },
    "/balance/{address}": { "get": { "summary": "Get Nakama balances", "parameters": [{ "$ref": "#/components/parameters/Address" }], "responses": { "200": { "description": "Total, available, reserved, and immature balances in pearl" } } } },
    "/nakama/{address}": { "get": { "summary": "Get Nakama UTXOs", "parameters": [{ "$ref": "#/components/parameters/Address" }], "responses": { "200": { "description": "Nakama UTXOs with spendable_height and immature status" } } } },
    "/name/{name}": { "get": { "summary": "Resolve an active Nakama name to its registered public key and address", "parameters": [{ "name": "name", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-z]{1,32}$" } }], "responses": { "200": { "description": "Active name, address, public key, and expires_at_height" }, "400": { "description": "Invalid, expired, or unknown name" } } } },
    "/names/{address}": { "get": { "summary": "List active names for an address", "parameters": [{ "$ref": "#/components/parameters/Address" }], "responses": { "200": { "description": "Active names and expires_at_height, limited to 100 with a has_more flag" } } } },
    "/public-key/{address}": { "get": { "summary": "Look up a registered public key by address", "parameters": [{ "$ref": "#/components/parameters/Address" }], "responses": { "200": { "description": "Registration status and public key" } } } },
    "/blocks/latest": { "get": { "summary": "Get latest blocks", "responses": { "200": { "description": "Blocks" } } } },
    "/block/{height}": { "get": { "summary": "Get block by height", "parameters": [{ "name": "height", "in": "path", "required": true, "schema": { "type": "integer", "format": "uint64" } }], "responses": { "200": { "description": "Block" } } } },
    "/explorer/address/{address}": { "get": { "summary": "Get address activity", "parameters": [{ "$ref": "#/components/parameters/Address" }], "responses": { "200": { "description": "Address activity" } } } },
    "/explorer/transaction/{transaction_id}": { "get": { "summary": "Get confirmed transaction", "parameters": [{ "name": "transaction_id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }], "responses": { "200": { "description": "Transaction" } } } }
  },
  "components": {
    "parameters": {
      "Address": { "name": "address", "in": "path", "required": true, "schema": { "type": "string" } }
    }
  }
}
